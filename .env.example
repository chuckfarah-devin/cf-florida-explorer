# Dedicated, referrer-restricted Florida Explorer key (basemap styles + geocoding only).
# Browser-visible by design. Never commit a real value; put it in .env.local.
VITE_ARCGIS_API_KEY=

# Optional exact frontend origin for an intentionally configured HTTPS reverse proxy.
# Leave unset for ordinary localhost development; no deployment is configured.
# PUBLIC_ORIGIN=https://your-preview-host.example
